# 复制为 backend/.env（不进 git）并按需修改。
# 所有 studio.config.Settings 字段用 STUDIO_ 前缀；未设置的用默认值。

# STUDIO_DATA_DIR=/absolute/path/to/data   # 默认：仓库根目录下的 data/
# STUDIO_HOST=127.0.0.1
# STUDIO_PORT=8000
# STUDIO_MAX_CONCURRENT_TURNS=2
# STUDIO_ENABLE_FAKE_RUNTIME=true
# STUDIO_FAKE_DELAY_SECONDS=0             # Fake 默认脚本回显与写文件之间的等待秒数（观察"运行中"用）
# STUDIO_ALLOWED_HOSTS=["127.0.0.1","localhost"]  # TrustedHostMiddleware 放行的 Host

# 模型 key 不是 Settings 字段：由 model_profiles 种子数据的 api_key_env
# 按名指定要读取的环境变量，这里按需提供（名字以后续任务落地的种子数据为准）。
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
