# 复制为 backend/.env（不进 git）并按需修改。
# 所有 studio.config.Settings 字段用 STUDIO_ 前缀；未设置的用默认值。

# STUDIO_DATA_DIR=/absolute/path/to/data   # 默认：仓库根目录下的 data/
# STUDIO_HOST=127.0.0.1
# STUDIO_PORT=8000
# STUDIO_MAX_CONCURRENT_TURNS=2
# STUDIO_ENABLE_FAKE_RUNTIME=true
# STUDIO_FAKE_DELAY_SECONDS=0             # Fake 默认脚本回显与写文件之间的等待秒数（观察"运行中"用）
# STUDIO_ALLOWED_HOSTS=["127.0.0.1","localhost"]  # TrustedHostMiddleware 放行的 Host

# 模型网关（可选；启动时由种子写进模型配置，见 docs/runbooks/dev-setup.md「模型网关」）：
# STUDIO_ANTHROPIC_BASE_URL=https://ccproxy.yukework.com   # claude-sonnet（API key 模式）的 ANTHROPIC_BASE_URL；claude-login 不受影响
# STUDIO_OPENAI_BASE_URL=https://openrouter.ai/api/v1      # gpt 的 base_url；非 api.openai.com 时不提供 Shell
# STUDIO_OPENAI_MODEL=openai/gpt-5                         # gpt 的模型名（OpenRouter 要带 openai/ 前缀）；不设则为 gpt-5

# 模型 key 不是 Settings 字段：由 model_profiles 种子数据的 api_key_env
# 按名指定要读取的环境变量，这里按需提供（名字以后续任务落地的种子数据为准）。
# ANTHROPIC_API_KEY=      # 走网关时填网关接受的 key
# OPENAI_API_KEY=         # 走 OpenRouter 时填 OpenRouter key
# DEEPSEEK_API_KEY=
