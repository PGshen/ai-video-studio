{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "studio.main:app",
        "--reload",
        "--reload-dir",
        "src",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "backend",
      "port": 8000,
      "env": {
        "STUDIO_ENABLE_FAKE_RUNTIME": "true"
      }
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5173
    }
  ]
}
