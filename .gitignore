# 运行时数据（数据库、快照内容、工作区、验证证据）；只有风格库正式版本入库共享
data/*
!data/styles/
# 风格保存中途被打断留下的临时目录（启动时会自动清理）
data/styles/.*.tmp-*/
data/styles/.*.old-*/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.import_linter_cache/

# 前端
node_modules/
dist/

# 环境与本地配置
.env
.env.*
!.env.example
.claude/settings.local.json
.DS_Store

# 本地工具工作区
.claude/worktrees/
.superpowers/

# 探索期的大文件（视频、音频、字体），不入库
docs/temp/
